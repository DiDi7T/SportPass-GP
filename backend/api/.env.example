# Copia este archivo como .env (en backend/api) y llena tus valores.
# .env NO se sube al repositorio: contiene contraseñas. Este .env.example sí, y nunca debe tener secretos.

# --- Base de datos (Supabase / PostgreSQL) -------------------------------------------------
# Pide los datos de conexión al equipo por un canal privado.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
# SSL activo por defecto (Supabase lo exige). Solo "false" para una base local sin SSL.
DB_SSL=true
# Debe quedar en false: el esquema se maneja con los archivos SQL de backend/api/migrations.
DB_SYNCHRONIZE=false

# --- Servidor ------------------------------------------------------------------------------
NODE_ENV=development
API_PORT=3001
# Origen del frontend al que se permite llamar a la API (CORS).
WEB_ORIGIN=http://localhost:3000

# --- Autenticación (HU1) -------------------------------------------------------------------
# Obligatorio en producción. En desarrollo, si se deja vacío, se usa una clave local de prueba.
JWT_ACCESS_SECRET=
REFRESH_TOKEN_DAYS=14

# --- Correo al docente (HU18) --------------------------------------------------------------
# Sin MAIL_HOST, en desarrollo se usa Ethereal: el correo no se entrega y la consola muestra un
# enlace para verlo. Con Gmail: smtp.gmail.com, 465, true, tu correo y una contraseña de aplicación
# (https://myaccount.google.com/apppasswords), nunca tu contraseña normal.
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=SportPass Icesi <tu-correo@gmail.com>
# Solo en desarrollo y demostraciones: desvía el correo del docente a esta dirección. El asunto
# conserva a quién iba dirigido. En producción se deja vacío para que llegue al docente real.
MAIL_REDIRECT_TO=
# Solo en desarrollo, junto con MAIL_REDIRECT_TO: desvía la copia del deportista a otra dirección.
MAIL_REDIRECT_CC_TO=
